{
  "name": "dsh-github-watch",
  "version": "0.2.1",
  "type": "module",
  "description": "DSH Settings page that lists every GitHub project on this machine, checks upstream for updates, and can update, mute or delete them",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "github",
    "inventory",
    "upstream"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumbge/dsh-github-watch.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./lib/*.mjs": "./lib/*.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "lib/*.mjs",
    "test/*.mjs"
  ],
  "scripts": {
    "test": "node --test test/parse.test.mjs test/pipeline.test.mjs test/routes.test.mjs test/render.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=18.0.0"
  }
}
